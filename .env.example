# DEMO_MODE only controls the OpenSearch adapter. Analysis still requires the LLM agent team.
DEMO_MODE=true
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENSEARCH_URL=https://opensearch.example.local:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_ALERT_INDEX=wazuh-alerts-*
OPENSEARCH_FINDINGS_INDEX=.opensearch-sap-*
CASES_INDEX=soc-cases-v1
TRACES_INDEX=soc-agent-traces-v1
KNOWLEDGE_INDEX=soc-knowledge-v1
AUDIT_INDEX=soc-audit-v1
