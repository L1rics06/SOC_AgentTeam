# DEMO_MODE only controls the OpenSearch adapter. Analysis still requires the LLM agent team.
DEMO_MODE=true
LLM_PROVIDER=siliconflow
OPENAI_ENABLED=true

# OpenAI-compatible fallback settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# SiliconFlow settings. Keep secrets in .env only; never put them in backend/app/config.py.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=1200
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY_SECONDS=0.8
OPENSEARCH_URL=https://opensearch.example.local:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_ALERT_INDEX=wazuh-alerts-*
OPENSEARCH_FINDINGS_INDEX=.opensearch-sap-*
CASES_INDEX=soc-cases-v1
TRACES_INDEX=soc-agent-traces-v1
KNOWLEDGE_INDEX=soc-knowledge-v1
AUDIT_INDEX=soc-audit-v1
